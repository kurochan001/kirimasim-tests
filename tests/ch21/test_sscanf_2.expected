Test 4: Parse binary
  $sscanf("1010", "%b") -> bin_val = 10 (0xa)
  PASS: Binary value parsed
Test 5: Parse real number
  $sscanf("3.14159", "%f") -> real_val = 3.14159
  PASS: Real number parsed
  $sscanf("-2.5e3", "%f") -> real_val = -2500.0
  PASS: Scientific notation parsed
Test 6: Parse string
  $sscanf("hello world", "%s") -> str_val = "hello"
  PASS: String parsed (first word)
Test 7: Mixed format parsing
  $sscanf("value=100", "value=%d") -> int_val = 100
  PASS: Mixed format parsed
Test 8: Return value
  $sscanf("1 2 3", "%d %d %d") returned 3
