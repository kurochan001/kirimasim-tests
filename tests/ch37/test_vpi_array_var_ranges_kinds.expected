sa (array var): array type static, left 2, right 5, ranges: [size 4, left 2, right 5], [size 2, left 0, right 1]
  typespec (array typespec): array type static, ranges: [size 4, left 2, right 5], [size 2, left 0, right 1]
da (array var): array type dynamic, left 0, right 2, ranges: [size 3, left 0, right 2]
  typespec (array typespec): array type dynamic, ranges: [size 0, left NULL, right NULL]
de (array var): array type dynamic, left NULL, right NULL, ranges: [size 0, left NULL, right NULL]
qa (array var): array type queue, left 0, right 1, ranges: [size 2, left 0, right 1]
  typespec (array typespec): array type queue, ranges: [size 0, left NULL, right NULL]
qe (array var): array type queue, left NULL, right NULL, ranges: [size 0, left NULL, right NULL]
aa (array var): array type associative, left NULL, right NULL, ranges: [size 0, left NULL, right NULL]
  typespec (array typespec): array type associative, ranges: [size 0, left NULL, right NULL]
mx (array var): left 1, right 0, ranges: [size 2, left 1, right 0], [size 0, left NULL, right NULL]
  typespec (array typespec): ranges: [size 2, left 1, right 0], [size 0, left NULL, right NULL]
mq (array var): left 0, right 1, ranges: [size 2, left 0, right 1], [size 0, left NULL, right NULL]
ma (array var): left 0, right 1, ranges: [size 2, left 0, right 1], [size 0, left NULL, right NULL]
lu (array var): array type static, left 1, right 2, ranges: [size 2, left 1, right 2]
pv (logic var): left 7, right 0, ranges: [size 8, left 7, right 0], [size 4, left 3, right 0]
  typespec (logic typespec): ranges: [size 8, left 7, right 0], [size 4, left 3, right 0]
bv (bit var): left 2, right 1, ranges: [size 2, left 2, right 1], [size 4, left 0, right 3]
  typespec (bit typespec): ranges: [size 2, left 2, right 1], [size 4, left 0, right 3]
ps (packed array var): left 1, right 0, ranges: [size 2, left 1, right 0]
pu (packed array var): left 0, right 2, ranges: [size 3, left 0, right 2]
pe (packed array var): left 2, right 0, ranges: [size 3, left 2, right 0]
